# Telegram (required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Marketplace search (use SEARCH_URL or KEYWORD + optional location slug)
SEARCH_URL=https://www.facebook.com/marketplace/nyc/search/?query=vintage%20camera
# SEARCH_KEYWORD=vintage camera
# MARKETPLACE_LOCATION_SLUG=nyc/search

# Sniper mode: poll warm feed tab, top N newest only (sortBy=creation_time_descend on URL)
SNIPER_MODE=true
USE_GRAPHQL=true
TOP_LISTINGS_LIMIT=5
CHECK_INTERVAL=15

# Time filter — Just listed / À l'instant / <= MAX_ALERT_AGE_MINUTES
TIME_FILTER_ENABLED=true
MAX_ALERT_AGE_MINUTES=10

# Browser (SCROLL_PASSES=0 for sniper — no deep scroll)
HEADLESS=true
BROWSER_USER_DATA_DIR=./data/browser_profile
PAGE_LOAD_TIMEOUT_MS=60000
SCROLL_PASSES=0

# SQLite path for deduplication
DATABASE_PATH=./data/seen_items.db
